# Copy to .env.local and fill in. Without a key, Dumpling falls back to plain rules (labelled as such).
OPENAI_API_KEY=

# Hosted storage: a Postgres connection string (Supabase, Neon, Vercel Postgres…).
# Without it, everything is saved as files under data/ — fine on one machine, not on Vercel.
DATABASE_URL=

# The key that encrypts GitHub and Jira tokens: any long random string. Set it when hosting.
DUMPLING_SECRET=

# The public address of this Dumpling, shown in the widget and API snippets.
NEXT_PUBLIC_DUMPLING_URL=

# Optional
OPENAI_MODEL=gpt-5.6-luna
# Sign-up: open by default; "invite" limits it to invited people (and the very first account).
DUMPLING_SIGNUP=
# Key that the feedback widget and POST /api/intake must present. Set your own when hosting.
DUMPLING_KEY=
# Path to chalk's "Report a problem" log, for the chalk connector only.
CHALK_REPORTS=
# GitHub Enterprise's API address, if you use it instead of github.com.
GITHUB_API_URL=
